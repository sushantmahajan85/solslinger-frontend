# Base URL of the Solslinger Express API (solslinger-backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shows an in-browser test wallet in the wallet picker so the flow can be tested
# without a wallet extension. Keep false in production.
NEXT_PUBLIC_ENABLE_DEV_WALLET=false

# Optional: play a licensed audio file in the lobby instead of the built-in original
# score ("The Bloody Raven Rag", synthesised in the browser). Leave empty to use the score.
NEXT_PUBLIC_LOBBY_MUSIC_URL=
